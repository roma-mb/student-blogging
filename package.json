{
  "name": "student-blogging",
  "version": "1.0.0",
  "description": "Api student blogging",
  "main": "dist/main.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:debug": "node --watch --inspect=0.0.0.0:9229 --import tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc-alias -p tsconfig.json --outDir dist",
    "start": "node dist/main.js",
    "test": "docker compose --env-file .env.test -p sb-dev -f deployment/compose.dev.yml run --rm api npm run test:local",
    "test:watch": "docker compose --env-file .env.test -p sb-dev -f deployment/compose.dev.yml run --rm api npm run test:watch:local",
    "test:coverage": "docker compose --env-file .env.test -p sb-dev -f deployment/compose.dev.yml run --rm api npm run test:coverage:local",
    "test:local": "NODE_ENV=test jest --passWithNoTests",
    "test:unit": "NODE_ENV=test jest --runInBand tests/unit",
    "test:unit:coverage": "NODE_ENV=test jest --runInBand --coverage tests/unit",
    "test:integration": "NODE_ENV=test jest --runInBand tests/integration",
    "test:ci": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run test:unit:coverage && npm run test:integration",
    "test:watch:local": "NODE_ENV=test jest --watch",
    "test:coverage:local": "NODE_ENV=test jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "docker:dev": "docker compose --env-file .env -p sb-dev -f deployment/compose.dev.yml up -d",
    "docker:dev:stop": "docker compose --env-file .env -p sb-dev -f deployment/compose.dev.yml stop",
    "docker:dev:build": "docker compose --env-file .env -p sb-dev -f deployment/compose.dev.yml build --no-cache",
    "docker:dev:dep": "docker compose --env-file .env -p sb-dev -f deployment/compose.dev.yml run --rm api npm ci",
    "docker:dev:down": "docker compose --env-file .env -p sb-dev -f deployment/compose.dev.yml down",
    "docker:dev:restart": "docker compose --env-file .env -p sb-dev -f deployment/compose.dev.yml restart",
    "docker:prod": "docker compose -p sb-prod -f deployment/compose.yml up -d",
    "docker:build": "docker compose -p sb-prod -f deployment/compose.yml build",
    "docker:restart": "docker compose -p sb-prod -f deployment/compose.yml restart",
    "docker:stop": "docker compose -p sb-prod -f deployment/compose.yml stop",
    "docker:down": "docker compose -p sb-prod -f deployment/compose.yml down",
    "docker:logs": "docker compose -p sb-prod -f deployment/compose.yml logs -f sb_api"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.115.0",
    "@fastify/cors": "11.2.0",
    "@fastify/swagger": "9.6.1",
    "@fastify/swagger-ui": "5.2.5",
    "argon2": "0.44.0",
    "dotenv": "17.2.3",
    "fastify": "5.8.2",
    "i18next": "25.8.0",
    "jsonwebtoken": "9.0.3",
    "mongodb": "7.0.0",
    "prom-client": "15.1.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.2.0",
    "@typescript-eslint/eslint-plugin": "8.54.0",
    "@typescript-eslint/parser": "8.54.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "jest": "30.2.0",
    "prettier": "3.8.1",
    "ts-jest": "29.4.6",
    "tsc-alias": "1.8.16",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.12.0",
    "npm": ">=11.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roma-mb/student-blogging.git"
  },
  "author": "roma-mb",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/roma-mb/student-blogging/issues"
  },
  "homepage": "https://github.com/roma-mb/student-blogging#readme"
}